{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acne Advisor Evaluation Case V3",
  "type": "object",
  "required": [
    "id", "category", "question", "conversation_history", "expected_behavior",
    "acceptable_origins", "expected_safety_level", "expected_entities", "expected_concepts",
    "forbidden_claims", "accepted_sources", "source_required", "format_contract",
    "naturalness_applicable", "critical_case", "notes"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "conversation_history": {"type": "array", "items": {"type": "object"}},
    "expected_behavior": {"enum": ["answer", "cautious_answer", "emergency_action", "refuse_or_redirect", "safe_insufficient_evidence"]},
    "acceptable_origins": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_safety_level": {"enum": ["normal", "caution", "urgent", "emergency", "out_of_domain"]},
    "expected_entities": {"type": "array", "items": {"type": "string"}},
    "expected_concepts": {"type": "array", "items": {"type": "string"}},
    "forbidden_claims": {"type": "array", "items": {"type": "string"}},
    "accepted_sources": {"type": "array", "items": {"type": "string"}},
    "source_required": {"type": "boolean"},
    "format_contract": {"type": "object"},
    "naturalness_applicable": {"type": "boolean"},
    "critical_case": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}

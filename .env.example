# =============================================================================

# ACNE ADVISOR AI - LOCAL DEVELOPMENT ENVIRONMENT

# =============================================================================

# Khong commit file .env len Git.

# Khong chia se API key hoac mat khau that.

# Khong thay embedding model hoac dimensions neu chua rebuild Qdrant.

# =============================================================================

# -----------------------------------------------------------------------------

# Application / API

# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
PREFLIGHT_CHECK_TIMEOUT_SECONDS=4.0

# -----------------------------------------------------------------------------

# Frontend

# -----------------------------------------------------------------------------

VITE_API_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------

# External API Providers

# Chi dien API key that trong file .env local.

# -----------------------------------------------------------------------------

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash
GOOGLE_FALLBACK_MODELS=gemini-3.1-flash-lite
LLM_PROVIDER=gemini
LLM_PROVIDER_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=ollama

LLAMA_CLOUD_API_KEY=

# -----------------------------------------------------------------------------

# Ollama Local LLM

# -----------------------------------------------------------------------------

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=640
OLLAMA_TRUNCATION_RETRY_ATTEMPTS=1
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_K=20
OLLAMA_TOP_P=0.9

# -----------------------------------------------------------------------------

# Embedding

# Khong thay doi model hoac dimensions neu chua rebuild Qdrant.

# -----------------------------------------------------------------------------

EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSIONS=3072

# -----------------------------------------------------------------------------

# Knowledge Base / Schema / Pipeline Versioning

# -----------------------------------------------------------------------------

KB_VERSION=frozen_phase1_build

TAXONOMY_VERSION=acne_taxonomy_2026_08
ENTITY_SCHEMA_VERSION=source_backed_entity_card
CHUNK_SCHEMA_VERSION=structure_first_chars_2400_no_overlap

INGESTION_PIPELINE_VERSION=frozen_phase1_build
PROMPT_VERSION=medical_prompt_v3
ANSWER_VERIFIER_VERSION=answer_verifier_v3
LLM_FALLBACK_POLICY_VERSION=llm_fallback_policy_v3
EVIDENCE_GROUNDING_VERSION=evidence_grounded_runtime_v1
NEO4J_SCHEMA_VERSION=neo4j_schema_v1

ANSWER_FORMATTING_CONTRACT_VERSION=answer_formatting_contract_v12
SOURCE_NORMALIZATION_VERSION=source_normalization_v1
CONVERSATION_CONTEXT_VERSION=conversation_context_v1
PERFORMANCE_INSTRUMENTATION_VERSION=performance_instrumentation_v1
GOOGLE_GENAI_SDK_VERSION=google_genai_sdk_v1
REPRODUCIBLE_ENVIRONMENT_VERSION=reproducible_environment_v1
END_TO_END_RELEASE_READINESS_VERSION=end_to_end_release_readiness_v1

# -----------------------------------------------------------------------------

# Ingestion

# Khong chay ingestion hoac rebuild collection neu chua co ke hoach rieng.

# -----------------------------------------------------------------------------

# Frozen Phase 1 chunking is defined in src/ingestion/chunking.py. It is not
# runtime-configurable. This delay is only an operational provider throttle.
EMBEDDING_BATCH_DELAY=12

# Runtime retrieval query retry: bounded retries for transient provider transport failures.
EMBEDDING_QUERY_MAX_ATTEMPTS=3
EMBEDDING_QUERY_RETRY_BASE_DELAY=1.0

# -----------------------------------------------------------------------------

# PostgreSQL

# Host port 5433 de tranh xung dot voi PostgreSQL hoac Odoo tai port 5432.

# -----------------------------------------------------------------------------

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=acne_agent_db
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/acne_agent_db
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5433/acne_agent_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_USE_NULL_POOL=false

# -----------------------------------------------------------------------------

# Neo4j

# -----------------------------------------------------------------------------

NEO4J_AUTH=neo4j/password

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=

# -----------------------------------------------------------------------------

# Qdrant

# -----------------------------------------------------------------------------

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

QDRANT_COLLECTION_NAME=acne_knowledge
# -----------------------------------------------------------------------------

# Redis / Answer Cache

# -----------------------------------------------------------------------------

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_SCHEMA_VERSION=v3
CACHE_PROMPT_VERSION=medical_prompt_v3
CACHE_ANSWER_VERSION=v7

CACHE_MAX_QUESTION_CHARS=600
CACHE_MIN_ANSWER_CHARS=350

# -----------------------------------------------------------------------------

# Input Control

# -----------------------------------------------------------------------------

MAX_MESSAGE_CHARS=500
MAX_MESSAGE_WORDS=120
MAX_QUESTION_MARKS=3

MAX_CONVERSATION_HISTORY_MESSAGES=10
MAX_HISTORY_MESSAGE_CHARS=1000

# -----------------------------------------------------------------------------

# Retrieval

# -----------------------------------------------------------------------------

RETRIEVAL_CANDIDATE_LIMIT=16
RETRIEVAL_CONTEXT_MAX_ITEMS=8
RETRIEVAL_CONTEXT_MAX_CHARS=6000
ENABLE_DIAGNOSTIC_RETRIEVE=false

# -----------------------------------------------------------------------------

# Answer Verifier / Answer Guard

# -----------------------------------------------------------------------------

ANSWER_VERIFIER_ENABLED=true
ANSWER_VERIFIER_STRICT=false
ANSWER_GUARD_MODE=metadata_only

SEVERITY_GUARD_VERSION=severity_aware_answer_guard_v1

# -----------------------------------------------------------------------------

# Safe Fallback Flow

# -----------------------------------------------------------------------------

SAFE_FALLBACK_FLOW_VERSION=safe_fallback_flow_v1

# -----------------------------------------------------------------------------

# Runtime Resilience

# -----------------------------------------------------------------------------

AGENT_TOTAL_TIMEOUT_SECONDS=210

RETRIEVAL_TIMEOUT_SECONDS=20
GEMINI_TIMEOUT_SECONDS=45
OLLAMA_TIMEOUT_SECONDS=160

LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=4

CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=60
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1

RUNTIME_RESILIENCE_VERSION=runtime_resilience_v1

# -----------------------------------------------------------------------------

# Observability / Debug

# -----------------------------------------------------------------------------

OBSERVABILITY_ENABLED=false
OBSERVABILITY_TRACE_DIR=logs/phase2_traces
OBSERVABILITY_MAX_TEXT_CHARS=500

PHASE2_DEBUG_METADATA=false

# Diagnostic and release-readiness test flags. Keep disabled for normal local runs.
RELEASE_READINESS_TEST_MODE=
RELEASE_READINESS_HEALTH_DOUBLE=false

# =============================================================================
# ACNE ADVISOR AI - ENVIRONMENT TEMPLATE (.env.example)
# =============================================================================
# Copy file nay sang .env va dien API key that tren may local.
# Khong commit file .env hoac API key that len Git.
# Khong thay embedding model hoac dimensions neu chua rebuild Qdrant.
# =============================================================================

# -----------------------------------------------------------------------------
# Application / API / Frontend
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
PREFLIGHT_CHECK_TIMEOUT_SECONDS=4.0
CHAT_DB_TIMEOUT_SECONDS=2

VITE_API_URL=http://127.0.0.1:8000
FRONTEND_PORT=8088
BACKEND_PORT=8000
# Existing Hugging Face hub directory. Compose defaults to USERPROFILE/.cache/huggingface/hub.
# HF_MODEL_CACHE_PATH=C:/Users/your-user/.cache/huggingface/hub
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
DOCKER_LLM_PROVIDER_FALLBACK_ENABLED=false
# Optional fully encoded SQLAlchemy URL for credentials containing URL delimiters.
# DOCKER_DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/acne_agent_db

# -----------------------------------------------------------------------------
# External API Providers (Runtime & Ingestion)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_FALLBACK_MODELS=gemini-3.1-flash-lite
LLM_PROVIDER=gemini
LLM_PROVIDER_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=ollama

LLAMA_CLOUD_API_KEY=

# -----------------------------------------------------------------------------
# Evaluation / RAGAS LLM-as-a-Judge (NVIDIA NIM - khong dung trong production chat)
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
RAGAS_JUDGE_PROVIDER=nvidia
RAGAS_JUDGE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
RAGAS_FALLBACK_JUDGE_MODELS=mistralai/mistral-large-4-1t-a52b,nvidia/nemotron-3-ultra-550b-a55b
RAGAS_EMBEDDING_MODEL=models/gemini-embedding-2

# -----------------------------------------------------------------------------
# Ollama Local LLM (Optional fallback)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=640
OLLAMA_TRUNCATION_RETRY_ATTEMPTS=1
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_K=20
OLLAMA_TOP_P=0.9

# -----------------------------------------------------------------------------
# Embedding (Giu nguyen khop chi muc Qdrant hien tai)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_DELAY=12
EMBEDDING_QUERY_MAX_ATTEMPTS=3
EMBEDDING_QUERY_RETRY_BASE_DELAY=1.0

# -----------------------------------------------------------------------------
# Knowledge Base / Pipeline Contract Versioning
# -----------------------------------------------------------------------------
TAXONOMY_VERSION=acne_taxonomy_2026_08
ENTITY_SCHEMA_VERSION=source_backed_entity_card
CHUNK_SCHEMA_VERSION=structure_preserving_blocks_and_lead_ins_chars_2400_no_overlap
INGESTION_PIPELINE_VERSION=frozen_phase1_build
PROMPT_VERSION=requested_scope_medical_prompt
LLM_FALLBACK_POLICY_VERSION=llm_fallback_policy_v3
EVIDENCE_GROUNDING_VERSION=evidence_grounded_runtime_v2
NEO4J_SCHEMA_VERSION=neo4j_schema_v1
ANSWER_FORMATTING_CONTRACT_VERSION=bounded_list_and_terminal_qualifier_formatting
SOURCE_NORMALIZATION_VERSION=source_normalization_v2
SAFE_FALLBACK_FLOW_VERSION=safe_fallback_flow_v4
PERFORMANCE_INSTRUMENTATION_VERSION=performance_instrumentation_v1
GOOGLE_GENAI_SDK_VERSION=google_genai_sdk_v1
REPRODUCIBLE_ENVIRONMENT_VERSION=reproducible_environment_v1
END_TO_END_RELEASE_READINESS_VERSION=end_to_end_release_readiness_v1

# -----------------------------------------------------------------------------
# PostgreSQL (Host port 5433 tranh xung dot port 5432)
# -----------------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=acne_agent_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/acne_agent_db
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5433/acne_agent_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_USE_NULL_POOL=false

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_AUTH=neo4j/password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=acne_knowledge

# -----------------------------------------------------------------------------
# Redis / Exact Answer Cache
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_SCHEMA_VERSION=v3
CACHE_ANSWER_VERSION=v10
CACHE_MAX_QUESTION_CHARS=600

# -----------------------------------------------------------------------------
# Input Control
# -----------------------------------------------------------------------------
MAX_MESSAGE_CHARS=500
MAX_CONVERSATION_HISTORY_MESSAGES=10
MAX_HISTORY_MESSAGE_CHARS=1000

# -----------------------------------------------------------------------------
# Retrieval & Local Reranker (GPU CUDA / BF16)
# -----------------------------------------------------------------------------
RETRIEVAL_CANDIDATE_LIMIT=16
RETRIEVAL_CONTEXT_MAX_ITEMS=9
RETRIEVAL_CONTEXT_MAX_CHARS=10000
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_PRECISION=bfloat16
RERANKER_BATCH_SIZE=16
RERANKER_TIMEOUT_SECONDS=8
GRAPH_RAG_ENABLED=true
GRAPH_RAG_WEIGHT=0.85
GRAPH_RAG_TIMEOUT_SECONDS=8
GRAPH_RAG_NEIGHBOR_EXPANSION_ENABLED=true
ENABLE_DIAGNOSTIC_RETRIEVE=false

# -----------------------------------------------------------------------------
# Runtime Resilience (Deadlines & Retries)
# -----------------------------------------------------------------------------
AGENT_TOTAL_TIMEOUT_SECONDS=210
RETRIEVAL_TIMEOUT_SECONDS=20
GEMINI_TIMEOUT_SECONDS=45
OLLAMA_TIMEOUT_SECONDS=160
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=4

# -----------------------------------------------------------------------------
# Observability / Langfuse
# -----------------------------------------------------------------------------
OBSERVABILITY_ENABLED=false
OBSERVABILITY_TRACE_DIR=logs/phase2_traces
OBSERVABILITY_MAX_TEXT_CHARS=500
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=local

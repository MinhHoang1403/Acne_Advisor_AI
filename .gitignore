# =============================================================================
# .gitignore – 12-Factor App / Python / Node.js / Docker
# =============================================================================

# ---------------------------------------------------------------------------
# Environment & Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
.envrc

*.pem
*.key
*.crt
secrets/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.Python

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
nosetests.xml
*.cover

# Type checking / lint caches
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Ignore notebooks by default, but keep the formal evaluation notebook
*.ipynb
!evaluation/formal_evaluation.ipynb

# Local notebook recovery backups
local_notebook_backups/

# Local evidence retained while replacing evaluation frameworks
/local_eval_backup/

# ---------------------------------------------------------------------------
# Node.js / Web (src/frontend)
# ---------------------------------------------------------------------------
node_modules/
src/frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Frontend build output
.next/
out/
src/frontend/dist/
.nuxt/
.output/

# Package lock files (choose one approach – keep only what you use)
# package-lock.json
# yarn.lock

# ---------------------------------------------------------------------------
# Data & Knowledge
# Keep selected reproducibility metadata, exclude large/generated data
# ---------------------------------------------------------------------------
data/*
data/raw/
data/processed/
data/embeddings/
data/cache/

!data/method_sources.json
!data/knowledge_build_manifest.json

!data/sources/
data/sources/*
!data/sources/manifest.yaml
!data/sources/web_records.yaml
!data/sources/claim_exclusions.yaml

!data/taxonomy/
data/taxonomy/*
!data/taxonomy/drug_aliases.yaml

# Keep sample_data structure but ignore large files
sample_data/
sample_data_*/
*.pdf
sample_data/**/*.pdf
sample_data/**/*.parquet
sample_data/**/*.arrow
!sample_data/.gitkeep

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
.docker/

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
postgres-data/
pgdata/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
log/
reports/

# ---------------------------------------------------------------------------
# Local thesis/report artifacts
# ---------------------------------------------------------------------------
/output/
/FINAL_KL_Acne_Rag.docx
/.audit_work/
~$*.docx
~$*.xlsx
~$*.pptx

# ---------------------------------------------------------------------------
# IDE / Editor
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
desktop.ini

# Additional OS metadata
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.bak
*.old
*.orig
*.rej
*.tmp
*.temp
.cache/
tmp/
temp/

# ---------------------------------------------------------------------------
# Formal evaluation runtime outputs
# These are created only when the researcher runs the evaluation notebook.
# Keep the methodology/package in Git, but keep runtime outputs local.
# ---------------------------------------------------------------------------
evaluation/results/*

# Keep the figures directory structure only
!evaluation/results/figures/
evaluation/results/figures/*
!evaluation/results/figures/.gitkeep